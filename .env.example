RIOT_API_KEY=

# Optional: enables League Match-V5 endpoints. Never falls back to the Valorant key.
LOL_RIOT_API_KEY=

AUTH_KEY=

DATABASE_URL=postgres://user:password@localhost:5432/riotrelay

# Only for the one-shot MariaDB -> PostgreSQL migration (see README)
# MARIADB_URL=mysql://user:password@localhost:3306/riotrelay

# Optional (Default : 0.0.0.0:3000)
BIND_ADDR=0.0.0.0:3000
